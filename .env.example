NEXT_PUBLIC_SUPABASE_URL=https://fchpvgfjjxjpxfmtsrnc.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Local default; replace with the exact HTTPS origin before a production build.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=local
# Features implemented in the v5 frontend and v2 backend are enabled by default.
NEXT_PUBLIC_FF_SYNC_WORKER=1
NEXT_PUBLIC_FF_MEDIA=1
NEXT_PUBLIC_FF_SEMANTIC=1
NEXT_PUBLIC_FF_ANKI=1
NEXT_PUBLIC_FF_ANKI_IO=1
NEXT_PUBLIC_FF_AI_INGEST=1
NEXT_PUBLIC_FF_GAMIFICATION=1
NEXT_PUBLIC_FF_COLLAB=1
NEXT_PUBLIC_FF_FSRS_OPT=1
NEXT_PUBLIC_FF_EXAMS=1
NEXT_PUBLIC_FF_OCCLUSION=1
NEXT_PUBLIC_FF_SYNC_V2=1
NEXT_PUBLIC_FF_SEMANTIC_SEARCH=1
NEXT_PUBLIC_FF_IMPORT_URL=1
NEXT_PUBLIC_FF_MCP=1
NEXT_PUBLIC_FF_TEMPLATE_RENDERER=1
NEXT_PUBLIC_FF_TAGS=1
NEXT_PUBLIC_FF_SOCRATIC=1
NEXT_PUBLIC_FF_TEMPLATES=1
NEXT_PUBLIC_FF_REFERENCES=1

# Observabilidade (opcional em desenvolvimento)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1.0
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_URL=https://sentry.io/
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_ENABLED=1
# Edge/Supabase: configure only in the function environment, never in NEXT_PUBLIC_*.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# POSTHOG_PROJECT_TOKEN=
# POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_SERVER_ENABLED=1
